// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ─── Better Auth Required Tables ────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String    @default("user") // "user" | "admin"
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  sessions    Session[]
  accounts    Account[]
  botSettings BotSettings?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─── Customer Management ──────────────────────────────────────────────────────

model Customer {
  id            String    @id @default(cuid())
  name            String    @unique
  nameNormalized  String?
  phone           String?
  email         String?
  company       String?
  notes         String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  demandRecords DemandRecord[]
  activities    CustomerActivity[]

  @@index([nameNormalized])
  @@map("customer")
}

model CustomerActivity {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  action      String
  description String
  senderId    String?
  sender      TelegramSender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@map("customer_activity")
  @@index([customerId])
  @@index([createdAt])
}

// ─── Telegram Data Collection ────────────────────────────────────────────────

model TelegramSender {
  id              String   @id @default(cuid())
  telegramUserId  BigInt   @unique
  firstName       String
  lastName        String?
  username        String?
  displayName     String
  messageCount    Int      @default(0)
  lastMessageAt   DateTime?
  activeReportType String   @default("none")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        TelegramMessage[]
  demandRecords   DemandRecord[]
  activities      CustomerActivity[]

  @@map("telegram_sender")
}

model TelegramMessage {
  id              String          @id @default(cuid())
  telegramMsgId   Int             @unique
  text            String
  senderId        String
  sender          TelegramSender  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatId          BigInt
  chatTitle       String?
  receivedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  demandRecords   DemandRecord[]

  @@map("telegram_message")
  @@index([senderId])
  @@index([receivedAt])
}

model DemandRecord {
  id              String           @id @default(cuid())
  messageId       String
  message         TelegramMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  senderId        String
  sender          TelegramSender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String?
  category        String           @default("general")
  status          String           @default("new")
  note            String

  // Demand Sheet fields
  serviceName     String?
  serviceAmount   Float?
  serviceQty      Int?
  followUpDate    DateTime?

  confidence      Float            @default(0.35)
  aiProvider      String           @default("heuristic")
  aiModel         String?
  extractedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("demand_record")
  @@index([messageId])
  @@index([senderId])
  @@index([category])
  @@index([status])
  @@index([followUpDate])
  @@index([createdAt])
  @@index([customerId])
  @@index([serviceName])
}

// ─── Q&A Knowledge Base ──────────────────────────────────────────────────────

model QADocument {
  id         String   @id @default(cuid())
  title      String
  content    String
  source     String   @default("telegram")   // "telegram" | "telegram_file" | "upload"
  fileType   String?  // MIME type e.g. "application/pdf", "image/png"
  fileName   String?  // Original file name
  senderId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("qa_document")
  @@index([createdAt])
}

// ─── Bot Settings (per user) ─────────────────────────────────────────────────

model BotSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botToken        String?
  geminiApiKey    String?
  geminiModel     String   @default("gemini-3.1-flash-lite-preview")
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bot_settings")
}

model ProjectExpiration {
  id                    String            @id @default(cuid())
  projectName           String            @map("project_name")
  url                   String?
  packageName           String?           @map("package_name")
  domainProvider        String?           @map("domain_provider")
  hostingProvider       String?           @map("hosting_provider")
  hostingRemark         String?           @map("hosting_remark")
  domainExpireDate      DateTime?         @map("domain_expire_date")
  hostingExpireDate     DateTime?         @map("hosting_expire_date")
  remark                String?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@map("project_expiration")
}

model WebsiteUpdate {
  id              String            @id @default(cuid())
  name            String
  url             String?
  businessType    String?           @map("business_type")
  packageName     String?           @map("package_name")
  status          String            @default("up_to_date") // "up_to_date" | "pending_update" | "in_progress"
  remark          String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("website_update")
}

